# Copy to .env for local dev. NEVER commit .env
APP_ENV=development            # development | production
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/donate
SECRET_KEY=change-me-long-random-string
ALLOWED_ORIGINS=http://localhost:3000   # comma separated; no "*" in production

# sandbox -> ZaloPay sandbox endpoint, live -> ZaloPay production endpoint
PAYMENT_MODE=sandbox
ENABLED_PROVIDERS=zalopay      # comma list: zalopay,vietqr,sandbox (sandbox is refused when APP_ENV=production)
DEFAULT_PROVIDER=zalopay
MIN_DONATION_VND=10000
MAX_DONATION_VND=50000000

ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_CALLBACK_URL=https://YOUR-API.onrender.com/api/v1/webhooks/zalopay

# VietQR (bank transfer QR + webhook from a bank-notification provider, e.g. SePay/Casso)
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
VIETQR_WEBHOOK_SECRET=

# Local-only fake gateway (never allowed in production)
SANDBOX_WEBHOOK_SECRET=sandbox-secret
